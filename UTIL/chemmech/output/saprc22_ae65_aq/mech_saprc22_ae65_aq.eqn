REAL(dp)  :: RKI_RXN_ACOH             ! rate constant for stated reaction label
!Flag to call SPECIAL_RATES rountine in Integrator 
  LOGICAL,  PARAMETER :: USE_SPECIAL_RATES = .FALSE.
! pointers and names to specific photolysis rates
