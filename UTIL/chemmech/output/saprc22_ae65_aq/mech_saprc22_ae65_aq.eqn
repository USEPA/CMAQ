#INLINE F90_UTIL
SUBROUTINE SPECIAL_RATES( N, Y)
!Purpose: calculate special rate operators and update
!         appropriate rate constants

  USE mech_saprc22_ae65_aq_Global
  IMPLICIT NONE

!Arguments:

   INTEGER,       INTENT( IN ) :: N      ! number of species
   REAL(kind=dp), INTENT( IN ) :: Y( N ) ! species concs


RETURN
END SUBROUTINE SPECIAL_RATES
#ENDINLINE
#INLINE F90_RCONST
!If( .Not. CALC_RCONST )Then
!   Return
!Else
!   CALC_RCONST = .False.
!End If
! Rate Constant Units produce reaction rates in ppm/min
RKI_RXN_4                 = FALL_OFF(   9.0000D-32,   0.0000D+00,  & 
 & -1.5000D+00,   3.0000D-11,   0.0000D+00,   0.0000D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_6                 = FALL_OFF(   2.5000D-31,   0.0000D+00,  & 
 & -1.8000D+00,   2.2000D-11,   0.0000D+00,  -7.0000D-01,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_11                = FALL_OFF(   3.6000D-30,   0.0000D+00,  & 
 & -4.1000D+00,   1.9000D-12,   0.0000D+00,   2.0000D-01,   1.3300D+00,  & 
 &  3.5000D-01 )
RKI_RXN_12                = FALL_OFF(   1.3000D-03,  -1.1000D+04,  & 
 & -3.5000D+00,   9.7000D+14,  -1.1080D+04,   1.0000D-01,   1.3300D+00,  & 
 &  3.5000D-01 )
RKI_RXN_22                = FALL_OFF(   7.0000D-31,   0.0000D+00,  & 
 & -2.6000D+00,   3.6000D-11,   0.0000D+00,  -1.0000D-01,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_25                = FALL_OFF(   3.2000D-30,   0.0000D+00,  & 
 & -4.5000D+00,   3.0000D-11,   0.0000D+00,   0.0000D+00,   1.2400D+00,  & 
 &  4.1000D-01 )
RKI_RXN_33                = FALL_OFF(   1.4000D-31,   0.0000D+00,  & 
 & -3.1000D+00,   4.0000D-12,   0.0000D+00,   0.0000D+00,   1.2600D+00,  & 
 &  4.0000D-01 )
RKI_RXN_34                = FALL_OFF(   4.1000D-05,  -1.0650D+04,  & 
 &  0.0000D+00,   6.0000D+15,  -1.1170D+04,   0.0000D+00,   1.2600D+00,  & 
 &  4.0000D-01 )
RKI_RXN_Q1N2              = FALL_OFF(   9.7000D-29,   0.0000D+00,  & 
 & -5.6000D+00,   9.3000D-12,   0.0000D+00,  -1.5000D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_S2OH              = FALL_OFF(   3.3000D-31,   0.0000D+00,  & 
 & -4.3000D+00,   1.6000D-12,   0.0000D+00,   0.0000D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_P1UI              = FALL_OFF(   1.0800D+00,  -1.4000D+04,  & 
 & -5.6000D+00,   1.0300D+17,  -1.4000D+04,  -1.5000D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_E1OH              = FALL_OFF(   1.1000D-28,   0.0000D+00,  & 
 & -3.5000D+00,   8.4000D-12,   0.0000D+00,  -1.7500D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
RKI_RXN_ACOH              = FALL_OFF(   5.5000D-30,   0.0000D+00,  & 
 &  0.0000D+00,   8.3000D-13,   0.0000D+00,   2.0000D+00,   1.0000D+00,  & 
 &  6.0000D-01 )
#ENDINLINE
#EQNTAGS ON
#EQUATIONS
// All rate constants converted from  molec/cm3 to ppm
// and 1/sec to 1/min
 <1> NO2 = NO + O3P  : RJCELL( IJ_NO2_06 ) ;
 <2> O3P + O2 + M = O3  :  RFACTOR_SQU * ARRD(   6.0000D-34, 0.0000D+0,  2.4000D+00 ) ;
 <3> O3P + O3 = DUMMY   :  RFACTOR * ARR2D(   8.0000D-12,  -2.0600D+03 ) ;
 <4> O3P + NO = NO2  :  RFACTOR * RKI_RXN_4                ;
 <5> O3P + NO2 = NO  :  RFACTOR * ARR2D(   5.1000D-12,   2.1000D+02 ) ;
 <6> O3P + NO2 = NO3  :  RFACTOR * RKI_RXN_6                ;
 <7> O3 + NO = NO2  :  RFACTOR * ARR2D(   3.0000D-12,  -1.5000D+03 ) ;
 <8> O3 + NO2 = NO3  :  RFACTOR * ARR2D(   1.2000D-13,  -2.4500D+03 ) ;
 <9> NO + NO3 = 2.00000*NO2  :  RFACTOR * ARR2D(   1.5000D-11,   1.7000D+02 ) ;
 <10> NO + NO + O2 = 2.00000*NO2  :  RFACTOR_SQU * ARR2D(   3.3000D-39,   5.3000D+02 ) ;
 <11> NO2 + NO3 = N2O5  :  RFACTOR * RKI_RXN_11               ;
 <12> N2O5 = NO2 + NO3  :  60.0D0 * RKI_RXN_12               ;
 <13> N2O5 + H2O = 2.00000*HNO3  :  RFACTOR *   0.0000D+00 ;
 <14> N2O5 + H2O + H2O = 2.00000*HNO3  :  RFACTOR_SQU *   0.0000D+00 ;
 <15> NO2 + NO3 = NO + NO2  :  RFACTOR * ARR2D(   4.5000D-14,  -1.2600D+03 ) ;
 <16> NO3 = NO  : RJCELL( IJ_NO3NO_06 ) ;
 <17> NO3 = NO2 + O3P  : RJCELL( IJ_NO3NO2_6 ) ;
 <18> O3 = O1D  : RJCELL( IJ_O3O1D_06 ) ;
 <19> O3 = O3P  : RJCELL( IJ_O3O3P_06 ) ;
 <20> O1D + H2O = 2.00000*OH  :  RFACTOR * ARR2D(   1.6300D-10,   6.0000D+01 ) ;
 <21> O1D + M = O3P  :  RFACTOR * ARR2D(   2.6500D-11,   9.8000D+01 ) ;
 <22> OH + NO = HONO  :  RFACTOR * RKI_RXN_22               ;
 <23> HONO = OH + NO  : RJCELL( IJ_HONO_06 ) ;
 <24> OH + HONO = NO2  :  RFACTOR * ARR2D(   1.8000D-11,  -3.9000D+02 ) ;
 <25> OH + NO2 = HNO3  :  RFACTOR * RKI_RXN_25               ;
 <26> OH + NO3 = HO2 + NO2  :  RFACTOR *   2.2000D-11 ;
 <27> OH + HNO3 = NO3  :  RFACTOR * EP2D(   2.4000D-14,   4.6000D+02,   2.7000D-17,   2.1990D+03,   6.5000D-34,   1.3350D+03 ) ;
 <28> HNO3 = OH + NO2  : RJCELL( IJ_HNO3 ) ;
 <29> OH + O3 = HO2  :  RFACTOR * ARR2D(   1.7000D-12,  -9.4000D+02 ) ;
 <30> HO2 + NO = OH + NO2  :  RFACTOR * ARR2D(   3.3000D-12,   2.7000D+02 ) ;
 <31> HO2 + NO = HNO3  :  RFACTOR * EP4D(   2.3900D-12,  -1.3770D+01,  -1.7110D+03,   1.8300D-32,  -4.8500D+00,  -7.7200D+02,   0.0000D+00,   0.0000D+00 ) ;
 <32> HO2 + NO + H2O = HNO3  :  RFACTOR_SQU * ARR2D(   1.2000D-35,   2.9440D+03 ) ;
 <33> HO2 + NO2 = HNO4  :  RFACTOR * RKI_RXN_33               ;
 <34> HNO4 = HO2 + NO2  :  60.0D0 * RKI_RXN_34               ;
 <35> HNO4 = 0.80000*HO2 +  0.80000*NO2 +  0.20000*OH +  0.20000*NO3  : RJCELL( IJ_HNO4_06 ) ;
 <36> HNO4 + OH = NO2  :  RFACTOR * ARR2D(   1.3000D-12,   3.8000D+02 ) ;
 <37> HO2 + O3 = OH  :  RFACTOR * ARR2D(   1.0000D-14,  -4.9000D+02 ) ;
 <38> HO2 + HO2 = HO2H  :  RFACTOR * EP3D(   3.0000D-13,   4.6000D+02,   2.1000D-33,   9.2000D+02 ) ;
 <39> HO2 + HO2 + H2O = HO2H  :  RFACTOR_SQU * EP3D(   4.2000D-34,   2.6600D+03,   2.9400D-54,   3.1200D+03 ) ;
 <40> NO3 + HO2 = OH + NO2  :  RFACTOR *   3.5000D-12 ;
 <41> NO3 + NO3 = 2.00000*NO2  :  RFACTOR * ARR2D(   8.5000D-13,  -2.4500D+03 ) ;
 <42> HO2H = 2.00000*OH  : RJCELL( IJ_H2O2 ) ;
 <43> HO2H + OH = HO2  :  RFACTOR *   1.8000D-12 ;
 <44> OH + HO2 = DUMMY   :  RFACTOR * ARR2D(   4.8000D-11,   2.5000D+02 ) ;
 <45> CO + OH = HO2 + CO2  :  RFACTOR * EP3D(   1.4400D-13,   0.0000D+00,   3.4300D-33,   0.0000D+00 ) ;
 <46> OH + H2 = HO2  :  RFACTOR * ARR2D(   2.8000D-12,  -1.8000D+03 ) ;
 <R2NO> SumRO2 + NO = NO  :  RFACTOR * ARR2D(   2.5500D-12,   3.8000D+02 ) ;
 <R2H2> SumRO2 + HO2 = HO2  :  RFACTOR *   1.4900D-11 ;
 <R2N3> SumRO2 + NO3 = NO3  :  RFACTOR *   2.3000D-12 ;
 <R2R2> SumRO2 + SumRO2 = DUMMY   :  RFACTOR *   1.6000D-14 ;
 <R3N2> SumRCO3 + NO2 = NO2  :  RFACTOR * ARRD(   7.7000D-12, 0.0000D+0, -2.0000D-01 ) ;
 <R3NO> SumRCO3 + NO = NO  :  RFACTOR * ARR2D(   6.7000D-12,   3.4000D+02 ) ;
 <R3H2> SumRCO3 + HO2 = HO2  :  RFACTOR * ARR2D(   3.1400D-12,   5.8000D+02 ) ;
 <R3N3> SumRCO3 + NO3 = NO3  :  RFACTOR *   4.0000D-12 ;
 <R3R2> SumRCO3 + SumRO2 = DUMMY   :  RFACTOR * ARR2D(   4.4000D-13,   1.0700D+03 ) ;
 <R3R3> SumRCO3 + SumRCO3 = DUMMY   :  RFACTOR *   1.7000D-11 ;
 <57> RO2C + NO = NO2  :   RCONST(   47 )  ;
 <58> RO2C + HO2 = DUMMY   :   RCONST(   48 )  ;
 <59> RO2C + NO3 = NO2  :   RCONST(   49 )  ;
 <60> RO2C + SumRO2 = SumRO2  :   RCONST(   50 )  ;
 <61> RO2C + SumRCO3 = SumRCO3  :   RCONST(   55 )  ;
 <62> RO2XC + NO = DUMMY   :   RCONST(   47 )  ;
 <63> RO2XC + HO2 = DUMMY   :   RCONST(   48 )  ;
 <64> RO2XC + NO3 = NO2  :   RCONST(   49 )  ;
 <65> RO2XC + SumRO2 = SumRO2  :   RCONST(   50 )  ;
 <66> RO2XC + SumRCO3 = SumRCO3  :   RCONST(   55 )  ;
 <67> MEO2 + NO = NO2 + HCHO + HO2  :  RFACTOR * ARR2D(   2.8000D-12,   3.0000D+02 ) ;
 <68> MEO2 + HO2 = 0.90000*MEOOH +  0.10000*HCHO  :  RFACTOR * ARR2D(   3.8000D-13,   7.8000D+02 ) ;
 <69> MEO2 + NO3 = HCHO + HO2 + NO2  :  RFACTOR *   1.2000D-12 ;
 <70> MEO2 + SumRO2 = 0.30000*HO2 +  0.65000*HCHO +  0.35000*MEOH  :  RFACTOR *   2.1600D-13 ;
 <71> MEO2 + SumRCO3 = 0.90000*HO2 + HCHO  :  RFACTOR * ARR2D(   2.0000D-12,   5.0000D+02 ) ;
 <72> ETO2 + NO = NO2 + HO2 + MECHO  :  RFACTOR * ARR2D(   2.5500D-12,   3.8000D+02 ) ;
 <73> ETO2 + HO2 = ROOH  :  RFACTOR *   7.4400D-12 ;
 <74> ETO2 + NO3 = NO2 + HO2 + MECHO  :  RFACTOR *   2.3000D-12 ;
 <75> ETO2 + SumRO2 = 0.50000*HO2 +  0.25000*ETOH +  0.75000*MECHO  :  RFACTOR *   2.9000D-14 ;
 <76> ETO2 + SumRCO3 = 0.80000*HO2 + MECHO  :  RFACTOR *   1.6000D-11 ;
 <77> BZO2 + NO = NO2 + BZO  :   RCONST(   47 )  ;
 <78> BZO2 + HO2 = ROOH  :   RCONST(   48 )  ;
 <79> BZO2 + NO3 = BZO + NO2  :   RCONST(   49 )  ;
 <80> BZO2 + SumRO2 = SumRO2 + BZO  :   RCONST(   50 )  ;
